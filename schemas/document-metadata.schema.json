{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/document-metadata.schema.json",
  "title": "Litenova Standards Document Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "normative", "appliesTo", "recipes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "kind": {
      "enum": ["core", "profile", "recipe", "reference", "template"]
    },
    "normative": { "type": "boolean" },
    "appliesTo": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" }
    },
    "recipes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    }
  }
}

