{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/recipe.schema.json",
  "title": "Litenova Standards Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "entry",
    "triggers",
    "replaces",
    "packages",
    "projects",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "entry": { "$ref": "#/$defs/path" },
    "triggers": { "$ref": "#/$defs/nonEmptyStrings" },
    "replaces": { "$ref": "#/$defs/strings" },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nuget", "npm"],
      "properties": {
        "nuget": { "$ref": "#/$defs/strings" },
        "npm": { "$ref": "#/$defs/strings" }
      }
    },
    "projects": { "$ref": "#/$defs/strings" },
    "gates": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
