{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/page-metadata.schema.json",
  "title": "Litenova ADDD Page Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "app", "route", "useCases"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "kind": { "const": "page" },
    "app": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "route": { "type": "string", "pattern": "^/" },
    "useCases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" }
    }
  }
}

